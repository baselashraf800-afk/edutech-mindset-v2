<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#0F172A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@mipmap/ic_launcher_round"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/widget_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="EduTech Mindset | عقلية التعليم"
            android:textColor="#38BDF8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_streak_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 يوم 1"
            android:textColor="#FBBF24"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_last_lesson"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="📚 آخر درس: المنصة التعليمية الذكية"
        android:textColor="#F8FAFC"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_btn_open"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="🚀 المنصة"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1D4ED8" />

        <Button
            android:id="@+id/widget_btn_whiteboard"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="🎨 السبورة"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0284C7" />

        <Button
            android:id="@+id/widget_btn_pomodoro"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="⏱️ التركيز"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#059669" />
    </LinearLayout>
</LinearLayout>
