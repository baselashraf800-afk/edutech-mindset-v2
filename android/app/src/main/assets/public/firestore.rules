rules_version = '2';

// ============================================================
//  قواعد الأمان المحصّنة — EduTech Mindset (الإصدار 216)
//  الصقها في: Firebase Console → Firestore Database → Rules → Publish
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // الإدارة: حساب Google الموثّق الخاص بالأستاذ باسل فقط (غير حساس لحالة الأحرف)
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email.lower() in ['baselashraf800@gmail.com', 'edutechm1994@gmail.com'];
    }

    // مشرف معتمد: بريده مسجّل في مجموعة mods (تضيفه الإدارة فقط)
    function isMod() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/mods/$(request.auth.token.email.lower()));
    }

    match /mods/{email} {
      allow read: if request.auth != null && (isAdmin() || request.auth.token.email.lower() == email.lower());
      allow write: if isAdmin();
    }

    // منشورات المشرفين: قراءة للجميع. النشر للمشرف/الإدارة، والتعديل والحذف لصاحب المنشور أو الإدارة
    match /posts/{postId} {
      allow read: if true;
      allow create: if (isAdmin() || isMod()) && request.resource.data.authorEmail == request.auth.token.email;
      allow update: if isAdmin() || (isMod() && resource.data.authorEmail == request.auth.token.email
                                    && request.resource.data.authorEmail == request.auth.token.email);
      allow delete: if isAdmin() || (isMod() && resource.data.authorEmail == request.auth.token.email);
    }

    // ===== نظام الصلاحيات المركزي (يصل لكل الأجهزة) =====
    // صلاحيات فرد: يقرؤها صاحبها والإدارة، وتكتبها الإدارة فقط.
    // (v163) لم نعد نشترط email_verified لقراءة الفرد لصلاحياته الخاصة فقط: حسابات الدخول
    // السريع التجريبي وحسابات البريد/كلمة المرور الجديدة تبقى بلا توثيق بريد لفترة، ويجب أن
    // تتمكن مع ذلك من رؤية ما مُنحت إياه إدارياً (قراءة صلاحياتها الخاصة فقط ليست بيانات حساسة).
    // التحقق من البريد يبقى إلزامياً لحساب الإدارة نفسه عبر isAdmin().
    match /grants/{email} {
      allow read: if isAdmin() || (request.auth != null
                                   && request.auth.token.email.lower() == email);
      allow write: if isAdmin();
    }
    // أكواد التفعيل وسجل التدقيق: الإدارة فقط
    match /private/{docId} {
      allow read, write: if isAdmin();
    }
    // طلبات الصلاحية: ينشئها صاحبها الموثّق فقط، وتقرؤها وتقرّرها الإدارة
    match /access_requests/{rid} {
      allow create: if request.auth != null
                    && request.auth.token.email_verified == true
                    && request.resource.data.userEmail == request.auth.token.email.lower()
                    && request.resource.data.status == "pending";
      allow read, update, delete: if isAdmin();
    }

    // محتوى الموقع (النصوص، الروابط، الإعلان): قراءة للجميع، كتابة للإدارة فقط
    match /site/{docId} {
      allow read: if docId != 'ai_vault' || isAdmin();
      allow write: if isAdmin();
    }

    // الموارد التعليمية: الإدارة والمشرفون المعتمدون ينشرون ويحررون، والحذف للإدارة فقط
    match /items/{itemId} {
      allow read: if true;
      allow create, update: if isAdmin() || isMod();
      allow delete: if isAdmin();
    }

    // موارد المواد الدراسية (كتب، أوراق عمل، ملخصات، اختبارات…)
    match /resources/{rid} {
      allow read: if true;
      allow create, update: if isAdmin() || isMod();
      allow delete: if isAdmin();
    }

    match /books/{bookId} {
      allow read: if true;
      allow create, update: if isAdmin() || isMod();
      allow delete: if isAdmin();
    }

    // الإعلانات: قراءة للجميع، كتابة للإدارة فقط
    match /ads/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // العروض التقديمية: يقرأ أي أحد العرض برابطه (get)، ولا يعدّد القائمة إلا صاحبها أو الإدارة
    match /presentations/{pid} {
      allow get: if true;
      allow list: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin())
                    && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // أصوات التصويت السريع
    match /pollVotes/{vid} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['pid', 'c0', 'c1', 'c2', 'c3', 'c4'])
                    && request.resource.data.pid is string
                    && request.resource.data.keys().size() == 2
                    && request.resource.data.get('c0', 0) + request.resource.data.get('c1', 0) + request.resource.data.get('c2', 0)
                       + request.resource.data.get('c3', 0) + request.resource.data.get('c4', 0) == 1;
      allow update: if request.resource.data.keys().hasOnly(['pid', 'c0', 'c1', 'c2', 'c3', 'c4'])
                    && request.resource.data.pid == resource.data.pid
                    && request.resource.data.diff(resource.data).affectedKeys().size() == 1
                    && request.resource.data.get('c0', 0) + request.resource.data.get('c1', 0) + request.resource.data.get('c2', 0)
                       + request.resource.data.get('c3', 0) + request.resource.data.get('c4', 0)
                       - (resource.data.get('c0', 0) + resource.data.get('c1', 0) + resource.data.get('c2', 0)
                       + resource.data.get('c3', 0) + resource.data.get('c4', 0)) == 1;
      allow delete: if request.auth != null
                    && get(/databases/$(database)/documents/presentations/$(resource.data.pid)).data.ownerUid == request.auth.uid;
    }

    // أوراق العمل والاختبارات: خاصة بصاحبها (والإدارة تقرأ)
    match /worksheets/{wid} {
      allow read: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // خطط الدروس: خاصة بصاحبها (والإدارة تقرأ)
    match /lessonplans/{lid} {
      allow read: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // التصاميم (بوسترات/إنفوغرافيك): خاصة بصاحبها (والإدارة تقرأ)
    match /designs/{did} {
      allow read: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // الاختبارات الإلكترونية: العرض العام بالرابط (get) وللمالك الكتابة
    match /exams/{eid} {
      allow get: if true;
      allow list: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // نتائج الاختبارات: يسلّمها الطالب بلا حساب، ويقرؤها ويصحّحها (المقالي/اليدوي) صاحب الاختبار أو الإدارة
    match /examResults/{rid} {
      allow create: if request.resource.data.keys().hasOnly(['examId', 'ownerUid', 'name', 'set', 'answers', 'correct', 'score', 'max', 'pct', 'secs', 'at'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
                    && request.resource.data.answers.size() <= 80
                    && request.resource.data.score is number && request.resource.data.max is number
                    && request.resource.data.score >= 0 && request.resource.data.score <= request.resource.data.max
                    && request.resource.data.max <= 500
                    // v215: تحقق من الأنواع والمدى كي لا تُخرَّب إحصاءات المعلم
                    && request.resource.data.pct is number && request.resource.data.pct >= 0 && request.resource.data.pct <= 100
                    && math.abs(request.resource.data.pct - (request.resource.data.max > 0 ? request.resource.data.score * 100 / request.resource.data.max : 0)) <= 1
                    && request.resource.data.secs is number && request.resource.data.secs >= 0 && request.resource.data.secs <= 86400
                    && request.resource.data.correct is list && request.resource.data.correct.size() <= 80
                    && request.resource.data.answers is list
                    && request.resource.data.set is string && request.resource.data.set.size() <= 4
                    && exists(/databases/$(database)/documents/exams/$(request.resource.data.examId))
                    && get(/databases/$(database)/documents/exams/$(request.resource.data.examId)).data.open == true
                    && get(/databases/$(database)/documents/exams/$(request.resource.data.examId)).data.ownerUid == request.resource.data.ownerUid;
      allow read: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow update: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin())
                    && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // الألعاب التربوية التفاعلية (جديد الإصدار 43): يفتحها الطالب بالرابط، ويديرها المعلم صاحبها
    match /games/{gid} {
      allow get: if true;
      allow list: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin())
                    && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // لوحة شرف الألعاب التفاعلية (Leaderboard) — محصّنة في الإصدار 52 ضد النقاط الوهمية
    match /gameScores/{sid} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['gameId', 'ownerUid', 'name', 'mode', 'score', 'secs', 'at'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
                    && request.resource.data.score is number
                    && request.resource.data.score >= 0 && request.resource.data.score <= 100000
                    // v216: تحقق أنواع إضافي كي لا تُلوَّث لوحة الشرف
                    && (!('secs' in request.resource.data) || (request.resource.data.secs is number && request.resource.data.secs >= 0 && request.resource.data.secs <= 86400))
                    && (!('mode' in request.resource.data) || (request.resource.data.mode is string && request.resource.data.mode.size() <= 20))
                    && exists(/databases/$(database)/documents/games/$(request.resource.data.gameId))
                    && get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.ownerUid == request.resource.data.ownerUid;
      allow delete: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // الفصول الافتراضية وبوابة الطالب (جديد الإصدار 43): يدخلها الطالب بالرمز (get)، وينشئها ويديرها المعلم
    match /classrooms/{cid} {
      allow get: if true;
      allow list: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin())
                    && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // الغرف الصفية الحية للمسابقات اللحظية (جديد الإصدار 44)
    match /liveRooms/{pin} {
      allow get: if true;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin())
                    && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // الواجبات المصوّرة وتسليمات دفاتر الطلاب (جديد الإصدار 46)
    match /homeworks/{hid} {
      allow get: if true;
      allow list: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin())
                    && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    match /hwSubmissions/{sid} {
      allow create: if request.resource.data.keys().hasOnly(['hwId', 'ownerUid', 'name', 'text', 'img', 'score', 'feedback', 'at'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
                    // v216: الطالب لا يكتب الدرجة ولا ملاحظات المعلم عند التسليم (يضعها المعلم لاحقاً بالتحديث)
                    && !('score' in request.resource.data) && !('feedback' in request.resource.data)
                    && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 8000))
                    && (!('img' in request.resource.data) || (request.resource.data.img is string && request.resource.data.img.size() <= 900000))
                    && exists(/databases/$(database)/documents/homeworks/$(request.resource.data.hwId))
                    && get(/databases/$(database)/documents/homeworks/$(request.resource.data.hwId)).data.ownerUid == request.resource.data.ownerUid;
      allow read, update, delete: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // بيانات «مساعدي» (مهام/ملاحظات/عادات) المتزامنة: خاصة بصاحبها فقط، بحجم محدود
    match /assistant/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['v', 'json', 'updatedAt'])
          && request.resource.data.json is string
          && request.resource.data.json.size() < 300000;
    }

    // حساب كل مستخدم: لا يقرأه ولا يكتبه إلا صاحبه (والإدارة للقراءة فقط)
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.keys().hasOnly([
               'uid', 'email', 'name', 'picture', 'role', 'subject', 'grade', 'school',
               'avatarColor', 'favorites', 'completedItems', 'likedItems', 'userNotes',
               'savedPrompts', 'userTasks', 'musicPrefs', 'activity',
               'createdAt', 'lastLoginAt', 'updatedAt'
             ]);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // تسجيلات الدورات الشاملة: الإنشاء متاح للمتدربين، والقراءة والتحديث والحذف للإدارة أو صاحب الطلب
    match /courses_enrollments/{ticketId} {
      allow create: if request.resource.data.keys().hasOnly([
               'ticketId', 'courseId', 'courseTitle', 'fullName', 'phone', 'email', 'city', 'role', 'org',
               'attendance', 'timePref', 'level', 'notes', 'dateStr', 'coursePrice', 'paymentMethod',
               'paymentRef', 'paymentStatus', 'status', 'createdAt', 'uid'
             ])
          && request.resource.data.ticketId == ticketId
          && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 200))
          && (!('org' in request.resource.data) || (request.resource.data.org is string && request.resource.data.org.size() <= 200))
          && (!('courseTitle' in request.resource.data) || (request.resource.data.courseTitle is string && request.resource.data.courseTitle.size() <= 300))
          && (!('paymentRef' in request.resource.data) || (request.resource.data.paymentRef is string && request.resource.data.paymentRef.size() <= 200))
          && (!('uid' in request.resource.data) || (request.resource.data.uid is string && request.resource.data.uid.size() <= 128))
          && request.resource.data.ticketId is string
          && request.resource.data.fullName is string && request.resource.data.fullName.size() > 1 && request.resource.data.fullName.size() <= 120
          && request.resource.data.phone is string && request.resource.data.phone.size() >= 6 && request.resource.data.phone.size() <= 30
          && request.resource.data.courseId is string
          && request.resource.data.status == 'قيد المراجعة'
          && (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus in ['مجانية', 'بانتظار تأكيد الدفع'])
          && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 500));
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }


    // إعدادات حسابات الدفع للدورات: قراءة للجميع، وتعديل للإدارة فقط
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

  }
}
